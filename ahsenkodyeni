import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.model_selection import StratifiedKFold, train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.naive_bayes import GaussianNB
from sklearn.linear_model import SGDClassifier
from sklearn.ensemble import RandomForestClassifier
from lightgbm import LGBMClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score, roc_curve, classification_report
from torch.utils.data import DataLoader, TensorDataset
import warnings

warnings.filterwarnings('ignore')

print("--- AHSEN: Final Proje Kodu Çalışıyor ---")

# 1. VERİ YÜKLEME
try:
    df = pd.read_csv('dataset.csv')
except:
    df = pd.read_csv('tracks.csv')

df['is_hit'] = np.where(df['popularity'] > 50, 1, 0)
df = df.drop(columns=['popularity']).select_dtypes(include=[np.number]).dropna()

# --- GÖRSEL 1: SINIF DAĞILIMI (PIE CHART) ---
plt.figure(figsize=(6, 6))
df['is_hit'].value_counts().plot.pie(autopct='%1.1f%%', labels=['Flop (0)', 'Hit (1)'], colors=['pink', 'purple'])
plt.title("Veri Seti Sınıf Dağılımı (Ahsen)")
plt.ylabel("")
plt.show()

X = df.drop(columns=['is_hit']).values
y = df['is_hit'].values

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, stratify=y, random_state=42)

# 2. PYTORCH MİMARİLERİ
# Mimari 1: Standart MLP
class MLP1(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, 64), 
            nn.ReLU(), 
            nn.Linear(64, 1), 
            nn.Sigmoid()
        )
    def forward(self, x): return self.net(x)

# Mimari 2: Derin ve Dropoutlu (Overfitting Önleyici) MLP
class MLP2(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, 128), 
            nn.ReLU(), 
            nn.Dropout(0.3), # Dropout katmanı
            nn.Linear(128, 64), 
            nn.ReLU(), 
            nn.Linear(64, 1), 
            nn.Sigmoid()
        )
    def forward(self, x): return self.net(x)

def train_pytorch_model(model_class, X_t, y_t):
    model = model_class(X_t.shape[1])
    criterion = nn.BCELoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001)
    train_data = DataLoader(TensorDataset(torch.FloatTensor(X_t), torch.FloatTensor(y_t).view(-1,1)), batch_size=64, shuffle=True)
    
    for epoch in range(20):
        for xb, yb in train_data:
            optimizer.zero_grad()
            loss = criterion(model(xb), yb)
            loss.backward()
            optimizer.step()
    return model

# 3. MODELLERİN ÇALIŞTIRILMASI
models = {
    "Naive Bayes (Base)": GaussianNB(),
    "SGD (Base)": SGDClassifier(loss='log_loss'),
    "Random Forest (Advanced)": RandomForestClassifier(n_estimators=100, max_depth=10),
    "LightGBM (Advanced)": LGBMClassifier(verbose=-1) # En iyi model adayı
}

results = []
plt.figure(figsize=(10, 8))

# ML Modelleri
for name, model in models.items():
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    y_prob = model.predict_proba(X_test)[:, 1] if hasattr(model, "predict_proba") else y_pred
    
    results.append([name, accuracy_score(y_test, y_pred), precision_score(y_test, y_pred), 
                    recall_score(y_test, y_pred), f1_score(y_test, y_pred), roc_auc_score(y_test, y_prob)])
    
    fpr, tpr, _ = roc_curve(y_test, y_prob)
    plt.plot(fpr, tpr, label=f"{name} (AUC={roc_auc_score(y_test, y_prob):.2f})")

# PyTorch Modelleri
for i, m_class in enumerate([MLP1, MLP2], 1):
    m = train_pytorch_model(m_class, X_train, y_train)
    m.eval()
    with torch.no_grad():
        y_prob = m(torch.FloatTensor(X_test)).numpy()
        y_pred = (y_prob > 0.5).astype(int)
        
    name = f"PyTorch MLP {i} (DL)"
    results.append([name, accuracy_score(y_test, y_pred), precision_score(y_test, y_pred), 
                    recall_score(y_test, y_pred), f1_score(y_test, y_pred), roc_auc_score(y_test, y_prob)])
    
    fpr, tpr, _ = roc_curve(y_test, y_prob)
    plt.plot(fpr, tpr, label=f"{name} (AUC={roc_auc_score(y_test, y_prob):.2f})")

# 4. SONUÇ RAPORLAMA

# TABLO 1: Genel
report_df = pd.DataFrame(results, columns=['Model', 'Accuracy', 'Precision', 'Recall', 'F1', 'AUC'])
print("\n--- TABLO 1: GENEL MODEL KARŞILAŞTIRMASI ---")
print(report_df.sort_values(by='F1', ascending=False))

# TABLO 2: Sınıf Bazlı (LightGBM İçin)
print("\n--- TABLO 2: SINIF BAZLI PERFORMANS (En İyi Model: LightGBM) ---")
best_model = models["LightGBM (Advanced)"]
y_pred_best = best_model.predict(X_test)
print(classification_report(y_test, y_pred_best, target_names=['Flop (0)', 'Hit (1)']))

# Görsel Ayarlar
plt.plot([0, 1], [0, 1], 'k--', alpha=0.5)
plt.title("ROC Curves - Ahsen")
plt.xlabel('False Positive Rate')
plt.ylabel('True Positive Rate')
plt.legend(loc="lower right")
plt.grid(True)
plt.show()